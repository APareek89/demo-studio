%% 01 · Master flow — Demo Studio (Sources → Align → Rehearse)
flowchart TD
  LG["Since 2026-09-04 this flow runs as ONE LangGraph graph — server/graph.py<br/>see diagram 00 (auto-exported) · Align = interrupt · sqlite checkpoints"]:::data
  PROV["TEXT providers · MODEL_TIER=eval default, customer opt-in<br/>[FUNCTION · server/config.py: health + llm/*]<br/>build: Gemini → Claude → Runware (configurable) · runtime: Gemini → Claude → Runware<br/>Runware: native JSON + Pydantic + one repair · usage + failure traces<br/>vision/speech keep their own models"]:::data
  PROV -.-> READ
  PROV -.-> ALIGN
  U["USER adds sources<br/>[ask · Studio › Sources]<br/>in: video, images, PDF/DOCX/TXT, product URL, pasted brand text"]:::ask
  ING["store.add_*_source<br/>[FUNCTION · server/store.py]<br/>in: uploads / URL<br/>out: sources[] in data/demos/id/demo.json"]:::fn
  READBTN["POST /api/demos/id/read<br/>[FUNCTION · server/app.py]<br/>gate: ≥1 source · keys present or MOCK_LLM=1"]:::fn
  READ["READ phase (thread)<br/>[FUNCTION · graph.py]<br/>Understand → Coach → Plan → Author → Deck → FAQ → opening message<br/>Coach progress label: Sales playbook · see diagrams 02 / 04"]:::fn
  SSE["GET /api/demos/id/events<br/>[FUNCTION · SSE, polls events.py every 0.35 s]<br/>out: progress / stage / status / message / phase_done"]:::fn
  OVER1["UI overlay<br/>'Reading your sources…'<br/>[FUNCTION · web/studio/align.js]"]:::term
  CARDS["Align: 6 cards<br/>Visuals · Facts · Script (Story order + slides) · Asked and answered · Persona & voice · CTAs<br/>[DATA · understanding.json + playbook.json + plan.json + script.json + deck.json + faq.json]"]:::data
  DOCK["USER speaks to the prompt dock<br/>[ask · text + optional files]"]:::ask
  ALIGN["Align loop<br/>[AGENT · Claude text tier → actions]<br/>see diagram 03"]:::agent
  APPR{"all 6 cards approved?<br/>[FUNCTION · demo.approvals]"}:::dec
  BUILD["BUILD phase (thread)<br/>[FUNCTION · graph.py]<br/>Voice → Bundle<br/>see diagram 04"]:::fn
  OVER2["UI overlay<br/>'Building your demo…'"]:::term
  BUNDLE["bundle.json<br/>[DATA · data/demos/id/bundle.json]"]:::data
  PLAY["Rehearse: player<br/>[FUNCTION · web/player/player.js]<br/>continuous stop narration · answers resume after 3 s · clarifications wait<br/>owned voice/typed turns; see diagram 05"]:::fn
  FB["USER gives feedback<br/>[ask · Rehearse feedback chat]"]:::ask
  FBA["POST /align + attachments → align agent (context=rehearse)<br/>[AGENT · Claude text tier]<br/>revise('author'|'plan'|'coach'|'understand') → human Align"]:::agent
  REHEARSE["USER selects Run rehearsal<br/>[ASK · Rehearse feedback chat]<br/>POST /api/demos/id/rehearsal · customer questions first, then uploaded questions<br/>empty bank only: at most five sample questions; diagnostics preserve publication"]:::ask
  HOME["Home workspace<br/>[FUNCTION · web/home.js · #/home default]<br/>real demo/session counts · recent demos · existing create/open actions"]:::fn
  LIB["My demos tab<br/>[DATA · list of data/demos/*/demo.json]<br/>search/filter · approved bundle thumbnails"]:::data

  HOME --> LIB
  HOME -.->|"create → Sources"| U
  U --> ING --> READBTN --> READ --> SSE --> OVER1 --> CARDS
  CARDS --> DOCK --> ALIGN --> CARDS
  CARDS --> APPR
  APPR -- "no" --> DOCK
  APPR -- "yes · POST /build" --> BUILD --> OVER2 --> BUNDLE --> PLAY
  PLAY --> FB --> FBA -.->|"review changed cards before Build"| CARDS
  PLAY -.-> REHEARSE
  LIB -.-> U

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
