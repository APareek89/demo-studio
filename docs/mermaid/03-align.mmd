%% 03 · Align loop — one prompt dock, one agent, structured actions
flowchart TD
  N6["SIX cards — Visuals · Facts · Script · FAQ bank · Persona · CTAs<br/>[DATA]<br/>Script includes Story order and Gemini full/partial/missing visual proof per line"]:::data
  STORY["USER reviews Story order above script segments<br/>[ask · existing Script card]<br/>drag stops; review kind, fact/picture counts and gaps; Ask for this source"]:::ask
  PBO["PATCH /align/playbook {stop_order, kinds}<br/>[FUNCTION · server/app.py]<br/>save playbook-overrides.json; revalidate effective playbook<br/>reset script + visuals approvals; dispatch existing revise plan path<br/>planner consumption of overrides follows in WP2"]:::fn
  MSG["USER message + optional files<br/>[ask · prompt dock or Rehearse feedback panel]"]:::ask
  ATT["attachments → sources<br/>[FUNCTION · app.align_message]<br/>files saved as role=product before the agent sees them"]:::fn
  BUSY{"is a stage running?<br/>[FUNCTION · orchestrator.is_running]"}:::dec
  WAIT["409 'Still working on the last change'<br/>[term]"]:::term
  HIST["conversation.json<br/>[DATA · last 12 turns sent as history]"]:::data
  AGENT["align agent<br/>[AGENT · Claude text tier · messages.parse]<br/>in: 6 cards summary (Visuals, Facts, Script, FAQ, Persona, CTAs), approvals, stage status, message, attachment list<br/>out: AlignOut · reply + actions[]"]:::agent
  APPLY{"action type<br/>[FUNCTION · orchestrator.apply_actions]"}:::dec
  A1["approve(card)<br/>[FUNCTION] approvals[card]=true → next-card prompt (template, no LLM)"]:::fn
  A2["edit_fact / remove_fact / resolve_unknown<br/>[FUNCTION] F/C lookup; validate truth and source ownership before save<br/>registries stay separate; downstream work and approvals stale"]:::fn
  A3["set_ctas / set_voice<br/>[FUNCTION] plan.json patched · voice sample re-rendered"]:::fn
  A4["request_upload<br/>[term] note only — user must add files"]:::term
  A5["revise(stage, instruction)<br/>[FUNCTION] lowest stage wins if several"]:::fn
  A6["build<br/>[FUNCTION] only if all 6 approved"]:::fn
  A7["answer<br/>[term] nothing changes"]:::term
  EDIT["USER reviews F/C facts, truth and source; edits script lines, one intake, check-ins, title/outcome<br/>[ask · edit modal]"]:::ask
  SAVEEDIT["validate schema, source ownership and grounding before save<br/>[FUNCTION · store.edit_fact / author.ungrounded / author.validate]<br/>question audio cleared; affected approvals and downstream work stale<br/>script visual audit only when requested (Gemini vision)"]:::fn
  FAQEDIT["USER edits a supported FAQ answer + fact ids<br/>[ask · card or Preview · labelled keyboard-focusable editor]<br/>question wording stays fixed; human checks meaning and scope"]:::ask
  FAQGATE{"finished current bank, no active run,<br/>and every citation approved + competition-eligible?<br/>[FUNCTION · app.edit_aligned_faq]<br/>reject empty citations and uncited claims"}:::dec
  FAQFAIL["400 invalid answer/citations or 409 stale/partial/running<br/>[term] no artifacts changed"]:::term
  FAQSAVE["save exact reviewed answer, question identity and registry hash<br/>[FUNCTION · PATCH /align/faq/{question_id}]<br/>clear old audio/error/clarification/callback; recompute allowed visual + slide<br/>slide targeting joins current script to saved deck design; no model call"]:::fn
  FAQBUILD["FAQ stays done; FAQ approval resets<br/>[FUNCTION · orchestrator.invalidate]<br/>voice / rehearsal / bundle become stale<br/>after approval, ordinary Build voices reviewed words without regenerating FAQ"]:::fn
  REV{"which stage?<br/>[FUNCTION · _revise thread]"}:::dec
  R1["understand(instr) → coach → plan<br/>affected approvals reset"]:::fn
  RC["coach(instr) → plan<br/>changed stops, kinds or USPs reset script + visuals"]:::fn
  R2["plan(instr) → voice sample"]:::fn
  R3["author(instr)"]:::fn
  RB{"demo was ready, or context=rehearse?"}:::dec
  RBUILD["author(if stale) → voice → bundle<br/>status ready · phase_done build"]:::fn
  RALIGN["status align · phase_done revise"]:::term
  REPLY["reply appended to conversation<br/>[DATA] + SSE 'message'"]:::data

  MSG --> ATT --> BUSY
  BUSY -- "yes" --> WAIT
  BUSY -- "no" --> HIST --> AGENT --> APPLY
  APPLY --> A1
  APPLY --> A2
  APPLY --> A3
  APPLY --> A4
  APPLY --> A5 --> REV
  APPLY --> A6
  APPLY --> A7
  REV -- "understand" --> R1 --> RB
  REV -- "coach" --> RC --> RB
  REV -- "plan" --> R2 --> RB
  REV -- "author" --> R3 --> RB
  RB -- "yes" --> RBUILD
  RB -- "no" --> RALIGN
  A1 --> REPLY
  A2 --> REPLY
  A3 --> REPLY
  A7 --> REPLY
  ATT -.->|"files but no revise action → revise('understand')"| A5
  N6 --> EDIT --> SAVEEDIT --> N6
  N6 --> STORY
  STORY -- "save order / kinds" --> PBO --> R2
  STORY -- "gap text: request_upload" --> A4
  N6 --> FAQEDIT --> FAQGATE
  FAQGATE -- "no" --> FAQFAIL
  FAQGATE -- "yes" --> FAQSAVE --> FAQBUILD --> N6

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
