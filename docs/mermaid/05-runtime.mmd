%% 05 · Runtime — the player (web/player/player.js) and grounded Q&A (server/agents/qa.py)
flowchart TD
  START["USER clicks Start<br/>[ask]"]:::ask
  PRELOAD["preload all authored speech + opening film<br/>[FUNCTION · retained Audio/Video objects]<br/>intake, narration, deeper lines, check-ins, FAQ, fillers and closing"]:::fn
  HERO["approved visual_asset stays centre stage<br/>[LIBRARY · model-viewer]<br/>script cue turns camera to front / side / rear / performance; supporting proof stays a labelled thumbnail"]:::data
  Q1["speak intake q1<br/>[LIBRARY · bundle audio, else /run/tts, else Web Speech]<br/>'your name + what should this change for you' (P02 open question)"]:::data
  L1["listen ≤10 s<br/>[LIBRARY · Web Speech recognition]<br/>mic denied or silent → typed fallback input"]:::data
  P1["parse name + focus topics<br/>[FUNCTION · parseName / parseFocus — regex + chip/segment keywords, NO LLM]"]:::fn
  FILM["tailored acknowledgement → opening film with audio → return line<br/>[FUNCTION · playIntroFilm]<br/>planner starts before film; film capped at 45 s; customer may skip"]:::fn
  OPEN["STANDARD OPENING · unchanged, 1-2 min<br/>[FUNCTION · playOpening]<br/>intro (frame) + outcome (end state first) · pre-rendered audio"]:::fn
  PITCH["pitch plan (starts before the film)<br/>[AGENT · claude-opus-5 · POST /run/pitch]<br/>in: profile (name, why), library of proof blocks, USPs, registry<br/>out: customer_state, decision frame, ONE follow-up, route, pictured custom batches, advance"]:::agent
  PV["grounding + visual validators<br/>[FUNCTION · pitch.plan_pitch / visuals.for_text_and_facts]<br/>segment ids exist · uncited claim dropped · literal picture beats contradictory sibling · establish last"]:::fn
  DF["speak personalised decision frame<br/>[LIBRARY · /run/tts]"]:::data
  FU["ask the ONE follow-up (P03) → listen ≤12 s<br/>[LIBRARY · Web Speech]"]:::data
  REF["refine route with the answer<br/>[AGENT · POST /run/pitch refine=true]"]:::agent
  FALL["fallback: bundle q2 + keyword focus order<br/>[FUNCTION] if the planner times out (45 s)"]:::fn
  PLAN["route = ordered proof blocks + establish<br/>[FUNCTION · buildRoute]"]:::fn
  LINE["play block: bridge then lines<br/>[FUNCTION] direct 3D camera from spoken feature · show supporting detail · card · cite 'sources: F..'<br/>speak: same-provider audio; captions if unavailable"]:::fn
  CHK["check-in question<br/>[LIBRARY · audio] then chips"]:::data
  WAIT["waitFor 15 s countdown + auto-listen 8 s<br/>[FUNCTION · interpretReply — regex, NO LLM]<br/>yes/continue · deeper · question · timeout"]:::fn
  DEEP["deeper lines (2-3, pre-authored)<br/>[FUNCTION]"]:::fn
  QIN["question text<br/>[ask · voice or 💬 typed]"]:::ask
  QA["POST /api/demos/id/run/qa<br/>[AGENT · claude-opus-5 · messages.parse]<br/>in: question, last 8 turns, profile, registry, visuals, CTAs<br/>out: QAOut · answer, fact_ids, visual_ref, escalate, cta, answered"]:::agent
  QV{"valid?<br/>[FUNCTION · qa.answer]<br/>fact_ids ⊆ registry AND (answered OR no number/claim words)"}:::dec
  SPEAK["speak answer · seek to visual · card 'Sources for that answer'<br/>[FUNCTION]"]:::fn
  NOG["'I'm not sure from the material — I won't guess; a salesperson can call you'<br/>[FUNCTION] question → understanding.unknowns (origin runtime) · offer_callback=true"]:::term
  LEAD{"customer says call me / gives a number?<br/>[FUNCTION · offerCallback, regex [6-9]\\d{9}]"}:::dec
  SAVE["POST /run/lead → leads/*.json<br/>[DATA] read back the number · continue"]:::data
  CONF["'Did that answer it?' → chips yes / not quite (20 s)<br/>[FUNCTION]"]:::fn
  RES["resume: next segment if at check-in, else same line<br/>[FUNCTION · resumeAfterQA]"]:::fn
  CLOSE["advance (personalised from the pitch plan, else closing lines) → CTA chips + Not yet<br/>[FUNCTION · closeFlow]"]:::fn
  HAND["handoff summary<br/>[FUNCTION · intentScore] → POST /run/session → sessions/s_*.json"]:::data

  START --> PRELOAD --> HERO --> Q1 --> L1 --> P1 --> FILM --> OPEN
  P1 -.->|"starts before film"| PITCH --> PV
  OPEN --> DF --> FU --> REF --> PLAN
  PV --> DF
  PITCH -.->|"timeout / error"| FALL --> PLAN
  PLAN --> LINE
  HERO -.->|"persistent while lines change"| LINE
  LINE --> CHK --> WAIT
  WAIT -- "continue / timeout" --> LINE
  WAIT -- "deeper" --> DEEP --> WAIT
  WAIT -- "question" --> QIN --> QA --> QV
  QV -- "yes" --> SPEAK --> CONF --> RES --> LINE
  QV -- "no" --> NOG --> LEAD
  LEAD -- "yes" --> SAVE --> RES
  LEAD -- "no / continue" --> RES
  SPEAK -.->|"clarifying_question (P03)"| QIN
  LINE -- "last segment" --> CLOSE --> HAND
  QIN -.->|"interrupt at any moment cancels speech (run token)"| LINE

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
