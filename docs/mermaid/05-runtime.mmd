%% 05 · Runtime — the player (web/player/player.js) and grounded Q&A (server/agents/qa.py)
flowchart TD
  START["USER clicks Start<br/>[ask]"]:::ask
  PRELOAD["preload all authored speech + opening film<br/>[FUNCTION · retained Audio/Video objects]<br/>intake, narration, deeper lines, check-ins, FAQ, fillers and closing"]:::fn
  HERO["hero slide on stage<br/>[FUNCTION · showSlideView(hero_open)]<br/>web/slide.js renderSlide in fit mode · one .slide-stack, slides cross-fade"]:::data
  Q1["speak the ONE intake question<br/>[LIBRARY · bundle audio, else /run/tts, else Web Speech]<br/>greeting + product + 'what are you buying it for, or shall we start?' (P02)"]:::data
  L1["listen ≤10 s<br/>[LIBRARY · Web Speech recognition]<br/>mic denied or silent → typed fallback input"]:::data
  P1["parse name + focus topics<br/>[FUNCTION · parseName / parseFocus — regex + chip/segment keywords, NO LLM]"]:::fn
  FILM["polite acknowledgement → opening film (overlay on the hero slide) → spoken return<br/>[FUNCTION · playIntroFilm]<br/>planner runs under recorded cover; film capped at 45 s; customer may skip"]:::fn
  OPEN["STANDARD OPENING · unchanged, 1-2 min<br/>[FUNCTION · playOpening]<br/>intro (frame) + outcome (end state first) · pre-rendered audio"]:::fn
  PITCH["pitch plan (starts before the film)<br/>[AGENT · RUNTIME_PROVIDERS gemini → claude, 15 s each · POST /run/pitch refine=true]<br/>in: needs + focus, proof library, USPs, registry<br/>out: customer state, decision frame, route, custom batches, advance"]:::agent
  PV["grounding + visual validators<br/>[FUNCTION · pitch.plan_pitch / visuals.for_text_and_facts]<br/>segment ids exist · uncited claim dropped · multi-fact batch→card · establish last"]:::fn
  DF["decision frame on a transient slide + speech<br/>[LIBRARY · /run/tts]"]:::data
  CUSTOM["custom proof batches as transient slides<br/>[FUNCTION · transientSlide]<br/>the named picture else the current one · cited facts as panel callouts"]:::fn
  FALL["fallback: bundle q2 + keyword focus order<br/>[FUNCTION] if the planner times out (45 s)"]:::fn
  PLAN["route = ordered content slides + establish<br/>[FUNCTION · buildRoute — pitch route by segment_id → slide]"]:::fn
  LINE["play slide: bridge, then lines<br/>[FUNCTION · playFrom / playLines]<br/>showSlideView cross-fades the slide · setRevealed(j) BEFORE line j's audio · last line's ended → next slide · no timer · next slide preloaded"]:::fn
  TRX["true transcript<br/>[FUNCTION · logHeard]<br/>an agent line is logged when its audio ENDS; cut off → heard prefix (currentTime / duration × words) marked interrupted; only this history goes to /run/qa"]:::fn
  CHK["check-in question<br/>[LIBRARY · audio] then chips"]:::data
  WAIT["waitFor 15 s countdown + auto-listen 8 s<br/>[FUNCTION · interpretReply — regex, NO LLM]<br/>yes/continue · deeper · question · timeout"]:::fn
  DEEP["deeper lines (2-3, pre-authored)<br/>[FUNCTION]"]:::fn
  QIN["question text<br/>[ask · voice or 💬 typed]"]:::ask
  QA["POST /api/demos/id/run/qa<br/>[AGENT · RUNTIME_PROVIDERS gemini → claude, 15 s each, one retry; all fail → decline + callback]<br/>in: question, the TRUE transcript (last 8 turns), profile, current slide_id, registry, visuals, CTAs<br/>out: answer, fact_ids, visual, escalate, topic, cta, answered + slide_id, route, callout_id"]:::agent
  QV{"valid?<br/>[FUNCTION · qa.answer]<br/>fact_ids ⊆ registry AND (answered OR no number/claim words)"}:::dec
  RT{"where does the answer live?<br/>[FUNCTION · deck.route_for — answer fact ids ∩ each slide's facts, else the question's words vs slide topics / titles · NO LLM]"}:::dec
  JUMP["jump: cross-fade to the slide that carries the facts · all callouts shown, the matching one lit · slide marked covered (reached later: title + first line, no check-in)<br/>[FUNCTION · showSlideView + highlight]"]:::fn
  SPEAK["speak the answer on the current slide (stay · none: matching callout lit) or on the target (jump)<br/>[FUNCTION]"]:::fn
  NOG["say 'I don't know from the material' without a source card<br/>[FUNCTION] question → understanding.unknowns (origin runtime) · open dealer-help form"]:::term
  LEAD{"customer says call me / gives a number?<br/>[FUNCTION · offerCallback, regex [6-9]\\d{9}]"}:::dec
  SAVE["POST /run/lead → leads/*.json<br/>[DATA] read back the number · continue"]:::data
  CONF["'Did that answer it?' → chips yes / not quite (20 s)<br/>[FUNCTION]"]:::fn
  LP{"lead prompt due?<br/>[FUNCTION]<br/>≥60 percent of demo OR ≥2 customer questions OR unknown answer"}:::dec
  POP["test-drive / dealer-help form<br/>[ask]<br/>name + ten-digit phone; dismissible; demo continues"]:::ask
  RES["resume: 'back to where we were' → the exact interrupted line (S.seg / S.line untouched by a jump — return stack depth 1); the next slide if the question came at a check-in<br/>[FUNCTION · resumeAfterQA]"]:::fn
  CLOSE["advance (personalised from the pitch plan, else closing lines) → CTA chips + Not yet<br/>[FUNCTION · closeFlow]"]:::fn
  HAND["handoff summary<br/>[FUNCTION · intentScore] → POST /run/session → sessions/s_*.json"]:::data

  START --> PRELOAD --> HERO --> Q1 --> L1 --> P1 --> FILM --> OPEN
  P1 -.->|"starts before film"| PITCH --> PV
  OPEN --> DF --> CUSTOM --> PLAN
  PV --> DF
  PITCH -.->|"timeout / error"| FALL --> PLAN
  PLAN --> LINE --> CHK
  LINE -.->|"every spoken line"| TRX
  CHK --> WAIT
  WAIT -- "continue / timeout" --> LINE
  WAIT -- "deeper" --> DEEP --> WAIT
  WAIT -- "question" --> QIN --> QA --> QV
  QV -- "yes" --> RT
  RT -- "stay / none" --> SPEAK
  RT -- "jump" --> JUMP --> SPEAK
  SPEAK --> CONF --> LP
  QV -- "no" --> NOG --> POP
  LP -- "yes" --> POP --> RES
  LP -- "no" --> RES
  LEAD -- "yes" --> SAVE --> RES
  LEAD -- "no / continue" --> RES
  QIN -.->|"explicit call request / phone"| LEAD
  SPEAK -.->|"clarifying_question (P03)"| QIN
  LINE -- "last segment" --> CLOSE --> HAND
  QIN -.->|"interrupt at any moment cancels speech (run token) → logHeard partial"| LINE

  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
