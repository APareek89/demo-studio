%% 00 · The demo workflow as a LangGraph graph (auto-exported from server/graph.py via graph.get_graph().draw_mermaid())
---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	understand(understand)
	plan(plan)
	align_enter(align_enter)
	align_wait(align_wait)
	author(author)
	voice(voice)
	rehearsal(rehearsal)
	bundle(bundle)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	align_enter --> align_wait;
	align_wait -.-> author;
	align_wait -.-> plan;
	align_wait -.-> understand;
	author -.-> align_enter;
	author -.-> voice;
	bundle --> finish;
	plan -.-> align_enter;
	plan -.-> author;
	rehearsal --> bundle;
	router -.-> align_wait;
	router -.-> author;
	router -.-> plan;
	router -.-> understand;
	understand --> plan;
	voice -.-> bundle;
	voice -.-> rehearsal;
	finish --> __end__;
	align_wait -.-> align_wait;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
