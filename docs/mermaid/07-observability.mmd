%% 07 · Observability — every model / speech call → trace.jsonl → Observability tab (web/observability.js)
flowchart TD
  CTX["contextvars current_demo · current_stage<br/>[FUNCTION · usage.py] set by orchestrator._run_stage (build stages) and by runtime routes (stage 'runtime'), translate sets 'translate'"]:::fn
  CALL["one call<br/>[LIBRARY · claude.py structured/_soft_structured/text · gemini.py structured/tts · sarvam.py tts/stt]<br/>t0 → response → latency_ms"]:::fn
  REC["usage.record (tokens / chars / seconds)<br/>[DATA · usage.jsonl] → cost estimate (Playground › Cost)"]:::data
  TR["usage.trace<br/>[DATA · trace.jsonl] {t, stage, kind, model, latency_ms, in, out, chars, usd, system[:6000], user[:6000], response[:6000], error}"]:::data
  STG["stage timings<br/>[DATA · demo.stages[stage] {status, started_at, seconds, error}] written by orchestrator._run_stage"]:::data
  API["GET /api/demos/id/trace?limit=N<br/>[FUNCTION] → {stages, rows, usage summary}"]:::fn
  TAB["Observability tab<br/>[ask · demo picker · stage filter]<br/>stage cards (seconds, status) · totals by model · calls table (when, stage, call·model, latency, tokens, cost) · click a row → system prompt, input, response, error"]:::ask
  MOCK["MOCK_LLM=1 · claude.structured traces the fake call too<br/>[FUNCTION] so the tab can be QA'd without spend"]:::fn

  CTX --> CALL --> REC
  CALL --> TR
  CTX --> STG
  TR --> API
  STG --> API
  REC --> API
  API --> TAB
  MOCK -.-> TR

