    {
      "id": "wheels",
      "title": "The wheel and tyre on the road",
      "role": "proof",
      "topic": "stance-and-ride",
      "outcome": "Choose wheels without assuming ride quality",
      "usp_ids": [],
      "lines": [
        {
          "text": "Outside, E and EX wear steel wheels with covers; alloys start at S(O). Choosing the wheel finish settles an appearance detail, leaving passenger and luggage arrangements to consider.",
          "step": "say",
          "visual": {
            "kind": "image",
            "ref": "im_pdf_a4463ebb4d4d6329f98a",
