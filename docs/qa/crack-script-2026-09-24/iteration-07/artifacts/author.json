          "start": 129.8,
          "duration": 16.3,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "Tyre-pressure monitoring is standard across all variants. The cluster illustration locates the wheel readings, but the numbers pictured are illustrative; they aren't pressure measurements from a customer's car.",
