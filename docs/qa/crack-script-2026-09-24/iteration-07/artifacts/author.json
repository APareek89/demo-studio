    {
      "id": "airbags-and-help-2",
      "title": "Airbags and help with the car ahead (cont.)",
      "role": "proof",
      "topic": "safety",
      "outcome": "Distinguish standard equipment and driving assistance",
      "usp_ids": [
        "airbags-from-the-start"
      ],
      "lines": [
        {
          "text": "Watching the car ahead remains the driver's job: King, King Knight and Lounge Edition add forward-collision warning and assistance, without replacing attentive driving. Cabin temperature is a different kind of control.",
          "step": "say",
