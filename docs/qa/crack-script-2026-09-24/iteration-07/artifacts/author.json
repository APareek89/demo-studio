          },
          "unverified": false,
          "id": "wheels-L1",
          "start": 82.0,
          "duration": 14.7,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "E and EX have R16 steel wheels with covers; EX(O) has R16 dual-tone styled steel. S(O) has R17 black alloys, SX and SX Premium R17 diamond-cut alloys, and King R18 diamond-cut alloys. S(O) Knight, King Knight and Lounge Edition have R18 matte black alloys.",
          "step": "say",
          "visual": {
            "kind": "image",
            "ref": "im_pdf_a4463ebb4d4d6329f98a",
            "focus": "Wheels by trim"
          },
          "fact_ids": [
            "F017"
          ],
          "card": "none",
          "delivery": {
            "tone": "warm",
            "pace": 1.0
          },
          "unverified": false,
          "id": "wheels-D1"
        },
        {
          "text": "The listed tyre specifications are 205 / 65 R16, 215 / 60 R17 and 215 / 55 R18. These size labels don't establish ride comfort, rough-road absorption or ground clearance; the wheel photograph cannot measure any of those.",
          "step": "say",
          "visual": {
            "kind": "image",
            "ref": "im_pdf_3706b9e10eac9af2dac8",
            "focus": "Wheel and tyre"
          },
          "fact_ids": [
