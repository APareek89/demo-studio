            "pace": 1.0
          },
          "unverified": false,
          "id": "wheels-L1",
          "start": 78.9,
          "duration": 14.2,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "R16 steel wheels with covers belong to E and EX; EX(O) has R16 styled steel. R17 black alloys belong to S(O), with R17 diamond-cut alloys on SX and SX Premium.",
          "step": "say",
          "visual": {
