    {
      "id": "engines-2",
      "title": "The engines and the brake-holding button (cont.)",
      "role": "proof",
      "topic": "powertrain",
      "outcome": "Choose an engine and gearbox combination",
      "usp_ids": [
        "choose-your-gears"
      ],
      "lines": [
        {
          "text": "Choosing the turbo petrol fixes the gearbox as an automatic, and that engine is listed only on King. King has other engines too, so keep the engine beside the trim name.",
          "step": "say",
          "visual": {
            "kind": "image",
            "ref": "im_pdf_eb83000c135195546031",
            "focus": "Turbo petrol engine"
          },
          "fact_ids": [
            "F003",
            "F005",
            "F006"
          ],
          "card": "none",
          "delivery": {
            "tone": "warm",
            "pace": 1.0
          },
          "unverified": false,
          "id": "engines-L2",
          "start": 48.9,
          "duration": 16.3,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [],
      "stop_id": "powertrain",
