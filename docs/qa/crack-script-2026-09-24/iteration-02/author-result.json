    {
      "id": "engines",
      "title": "The engines and the brake-holding button",
      "role": "proof",
      "topic": "powertrain",
      "outcome": "Choose an engine and gearbox combination",
      "usp_ids": [
        "choose-your-gears"
      ],
      "lines": [
        {
          "text": "Changing gears yourself is one choice with non-turbo petrol or diesel; both also offer automatics, with combinations set by trim. That leaves the separate turbo engine as a different gearbox decision.",
          "step": "say",
          "visual": {
            "kind": "image",
            "ref": "im_pdf_df8fadffe78c7af4bbc1",
            "focus": "Manual gear changes"
          },
          "fact_ids": [
            "F003",
            "F008",
            "F009"
          ],
          "card": "none",
          "delivery": {
            "tone": "warm",
            "pace": 1.0
          },
          "unverified": false,
          "id": "engines-L1",
          "start": 32.6,
          "duration": 16.3,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [],
      "stop_id": "powertrain",
