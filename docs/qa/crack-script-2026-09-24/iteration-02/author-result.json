    {
      "id": "controls-2",
      "title": "Your temperature settings and phone connection (cont.)",
      "role": "proof",
      "topic": "cabin-and-tech",
      "outcome": "Choose individual settings and compatible connections",
      "usp_ids": [],
      "lines": [
        {
          "text": "Connecting a compatible mobile phone brings wireless Android Auto or Apple CarPlay from EX. From SX, that wireless connection needs a wired-to-wireless adapter, so include the adapter when considering the cabin equipment.",
