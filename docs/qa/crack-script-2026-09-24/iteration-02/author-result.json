    {
      "id": "safety-2",
      "title": "The seats and the help beside your lane (cont.)",
      "role": "proof",
      "topic": "safety",
      "outcome": "Distinguish standard equipment and driving assistance",
      "usp_ids": [
        "airbags-from-the-start"
      ],
      "lines": [
        {
          "text": "Across the lane diagram, marked lines show the car's surroundings. King, King Knight and Lounge Edition offer lane-keeping assistance, with safe, attentive driving still fully the driver's responsibility at the controls.",
          "step": "say",
          "visual": {
            "kind": "image",
            "ref": "im_pdf_2814e44d0603eba5c07b",
            "focus": "Lane detection illustration"
          },
          "fact_ids": [
            "F031",
            "F033",
            "F034"
          ],
          "card": "none",
          "delivery": {
            "tone": "warm",
            "pace": 1.0
          },
          "unverified": false,
          "id": "safety-L2",
          "start": 128.9,
          "duration": 16.3,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "Standard equipment also includes stability control, front and rear disc brakes, hill-start assistance, tyre-pressure monitoring and rear parking sensors. Hyundai describes hill-start assistance as preventing backward rolling on slopes; it remains assistance for a responsible driver.",
          "step": "say",
          "visual": {
            "kind": "none",
            "ref": "",
            "focus": ""
          },
          "fact_ids": [
            "F026",
            "F027",
            "F028",
            "F029",
            "F030",
            "F062"
          ],
          "card": "none",
          "delivery": {
            "tone": "warm",
            "pace": 1.0
          },
          "unverified": false,
          "id": "safety-D1"
        },
        {
          "text": "King, King Knight and Lounge have forward collision warning and avoidance assistance for cars, pedestrians and cyclists, plus blind-spot warning and avoidance assistance. Safe, attentive driving remains essential; intervention is not guaranteed in every case.",
          "step": "say",
          "visual": {
            "kind": "none",
            "ref": "",
            "focus": ""
          },
          "fact_ids": [
            "F031",
            "F032",
            "F033",
            "F034"
          ],
          "card": "none",
          "delivery": {
            "tone": "warm",
            "pace": 1.0
          },
          "unverified": false,
          "id": "safety-D2"
        },
        {
          "text": "Surround and blind-spot view monitors start at SX Premium. Smart Cruise Control with Stop and Go is limited to King, King Knight and Lounge automatics; SX Premium cameras do not include that cruise feature. The driver must remain safe and attentive.",
          "step": "say",
          "visual": {
            "kind": "none",
            "ref": "",
            "focus": ""
          },
          "fact_ids": [
            "F035",
            "F036",
            "F034"
          ],
          "card": "none",
          "delivery": {
            "tone": "warm",
            "pace": 1.0
          },
          "unverified": false,
          "id": "safety-D3"
        }
      ],
