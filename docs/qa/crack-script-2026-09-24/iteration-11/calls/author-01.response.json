    {
      "id": "airbags-and-help-2",
      "title": "Airbags and help with the car ahead (cont.)",
      "role": "proof",
      "topic": "safety",
      "outcome": "Distinguish standard equipment and driving assistance",
      "usp_ids": [
        "airbags-from-the-start"
      ],
      "lines": [
        {
          "text": "Watching the car ahead always stays the driver's responsibility, including with forward-collision warning and assistance on King, King Knight and Lounge Edition. Before driving, there's also the cabin temperature to set.",
          "step": "say",
          "visual": {
            "kind": "image",
