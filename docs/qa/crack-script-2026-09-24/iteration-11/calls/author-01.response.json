          "start": 80.4,
          "duration": 14.7,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "The wheel mapping is R16 steel with covers on E and EX, R16 styled steel on EX(O), R17 black alloys on S(O), and R17 diamond-cut alloys on SX and SX Premium. King has R18 diamond-cut alloys; S(O) Knight, King Knight and Lounge Edition have R18 matte black alloys.",
          "step": "say",
          "visual": {
            "kind": "none",
            "ref": "",
            "focus": ""
          },
          "fact_ids": [
            "F017"
          ],
          "card": "none",
          "delivery": {
            "tone": "warm",
            "pace": 1.0
          },
          "unverified": false,
          "id": "wheels-D1"
        },
        {
          "text": "The stated tyre sizes are 205/65 R16, 215/60 R17 and 215/55 R18. These size codes do not establish a ride-comfort comparison, suspension specification or ground-clearance figure, and the wheel photo cannot measure diameter.",
          "step": "say",
          "visual": {
            "kind": "none",
            "ref": "",
            "focus": ""
          },
          "fact_ids": [
            "F064"
          ],
          "card": "none",
          "delivery": {
