    {
      "id": "climate-and-remote",
      "title": "The temperature controls inside and at home",
      "role": "proof",
      "topic": "cabin-and-tech",
      "outcome": "Choose local and remote temperature controls",
      "usp_ids": [],
      "lines": [
        {
          "text": "Turn to the two temperature displays when driver and front passenger prefer separate settings: independent climate control starts at S(O). The cabin setting also matters before anyone settles into the seats.",
          "step": "say",
          "visual": {
            "kind": "image",
            "ref": "im_pdf_f14b998cc020fdfef1d5",
