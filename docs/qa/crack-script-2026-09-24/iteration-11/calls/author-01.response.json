          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "Auto hold is listed for automatic S(O), S(O) Knight and SX Premium cars, and as standard on King, King Knight and Lounge Edition. E, EX, EX(O) and SX do not have it.",
