      "usp_ids": [
        "space-for-changing-plans"
      ],
      "lines": [
        {
          "text": "When a journey involves passengers and bags, the standard split rear seat lets seating and storage share the cabin differently. Passenger space is only part of choosing what surrounds the people inside.",
          "step": "say",
          "visual": {
            "kind": "image",
            "ref": "im_pdf_adb415f161dfc9567dde",
            "focus": "Folded seatback sections"
          },
          "fact_ids": [
