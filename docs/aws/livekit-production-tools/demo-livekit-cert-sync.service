[Unit]
Description=Refresh the protected LiveKit TURN TLS certificate
After=caddy.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/demo-livekit/sync_turn_certificate.py
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/demo-livekit /run
TimeoutStartSec=120
TimeoutStopSec=20
