{
  "segments": [
    {
      "id": "intro-overview",
      "title": "Welcome to Tata Nexon",
      "role": "intro",
      "topic": "overview",
      "outcome": "",
      "usp_ids": [],
      "lines": [
        {
          "text": "The Tata Nexon is a compact SUV built under four metres for easy city handling and relaxed highway driving.",
          "step": "frame",
          "visual": null,
          "fact_ids": [
            "F012"
          ],
          "card": "none",
          "unverified": false,
          "id": "intro-overview-L1",
          "start": 0.0,
          "duration": 10.0,
          "exact": false
        },
        {
          "text": "It gives you flexible cabin room and powertrain choices tailored to your daily routine.",
          "step": "say",
          "visual": null,
          "fact_ids": [],
          "card": "none",
          "unverified": false,
          "id": "intro-overview-L2",
          "start": 10.0,
          "duration": 7.4,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "Its overall length is 3,995 millimetres with a wheelbase of 2,498 millimetres.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F012"
          ],
          "card": "facts",
          "unverified": false,
          "id": "intro-overview-D1"
        },
        {
          "text": "This keeps parking manageable in dense urban spaces while preserving passenger legroom.",
          "step": "translate",
          "visual": null,
          "fact_ids": [],
          "card": "none",
          "unverified": false,
          "id": "intro-overview-D2"
        }
      ],
      "start": 0.0,
      "duration": 17.4,
      "spoken": 17.4
    },
    {
      "id": "three-reminders",
      "title": "Three Highlights to Guide Your Tour",
      "role": "outcome",
      "topic": "pillars",
      "outcome": "Three core pillars spanning comfort, engine flexibility, and safety",
      "usp_ids": [
        "usp-comfort",
        "usp-powertrains",
        "usp-safety"
      ],
      "lines": [
        {
          "text": "The three things I'd pay attention to are available seat ventilation, flexible engine choices, and standard five-star safety architecture.",
          "step": "say",
          "visual": null,
          "fact_ids": [
            "F003",
            "F007",
            "F020"
          ],
          "card": "none",
          "unverified": false,
          "id": "three-reminders-L1",
          "start": 17.4,
          "duration": 10.0,
          "exact": false
        },
        {
          "text": "You can steer us toward whichever matters most to you first.",
          "step": "advance",
          "visual": null,
          "fact_ids": [],
          "card": "none",
          "unverified": false,
          "id": "three-reminders-L2",
          "start": 27.4,
          "duration": 5.8,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "We can explore certified safety ratings, boot volume, or transmission choices whenever you wish.",
          "step": "say",
          "visual": null,
          "fact_ids": [
            "F006",
            "F014",
            "F018"
          ],
          "card": "none",
          "unverified": false,
          "id": "three-reminders-D1"
        },
        {
          "text": "Tell me anytime which part of the car you want to inspect in detail.",
          "step": "advance",
          "visual": null,
          "fact_ids": [],
          "card": "none",
          "unverified": false,
          "id": "three-reminders-D2"
        }
      ],
      "start": 17.4,
      "duration": 15.8,
      "spoken": 15.8
    },
    {
      "id": "exterior-stance",
      "title": "Compact Proportions and Ground Clearance",
      "role": "proof",
      "topic": "exterior",
      "outcome": "Evaluating sub-4-meter dimensions and unladen ground clearance",
      "usp_ids": [],
      "lines": [
        {
          "text": "One thing you'll notice first is the stance.",
          "step": "frame",
          "visual": {
            "kind": "image",
            "ref": "im01",
            "focus": "Tata Nexon exterior"
          },
          "fact_ids": [],
          "card": "none",
          "unverified": false,
          "id": "exterior-stance-L1",
          "start": 33.2,
          "duration": 4.2,
          "exact": false
        },
        {
          "text": "With an unladen ground clearance of 208 millimetres, it gives you useful underbody margin on rough roads.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F013"
          ],
          "card": "none",
          "unverified": false,
          "id": "exterior-stance-L2",
          "start": 37.4,
          "duration": 8.9,
          "exact": false
        }
      ],
      "checkin": "Does that ground clearance suit the roads you usually travel on?",
      "deeper": [
        {
          "text": "The SUV measures 1,804 millimetres wide and 1,620 millimetres tall across all personas.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F012"
          ],
          "card": "facts",
          "unverified": false,
          "id": "exterior-stance-D1"
        },
        {
          "text": "Wheel sizes range from 195/60 R16 on Smart and Pure trims to 215/60 R16 on Creative and Fearless.",
          "step": "translate",
          "visual": null,
          "fact_ids": [
            "F017"
          ],
          "card": "none",
          "unverified": false,
          "id": "exterior-stance-D2"
        }
      ],
      "checkin_start": 46.3,
      "checkin_duration": 5.8,
      "start": 33.2,
      "duration": 18.9,
      "spoken": 13.1
    },
    {
      "id": "cabin-comfort",
      "title": "Interior Comfort and Climate",
      "role": "proof",
      "topic": "comfort",
      "outcome": "Inspecting front-seat ventilation and passenger climate comfort",
      "usp_ids": [
        "usp-comfort"
      ],
      "lines": [
        {
          "text": "Now the part you'd live with daily.",
          "step": "frame",
          "visual": null,
          "fact_ids": [],
          "card": "none",
          "unverified": false,
          "id": "cabin-comfort-L1",
          "start": 52.1,
          "duration": 3.7,
          "exact": false
        },
        {
          "text": "Rear air conditioning vents come standard from the Pure Plus trim, while front seat ventilation is included on the Fearless Plus PS.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F020",
            "F021"
          ],
          "card": "contrast",
          "unverified": false,
          "id": "cabin-comfort-L2",
          "start": 55.8,
          "duration": 11.6,
          "exact": false
        }
      ],
      "checkin": "Would front ventilated seats make a big difference in your daily drive?",
      "deeper": [
        {
          "text": "Ventilated seats are fitted specifically for both the driver and co-driver on the Fearless Plus PS trim.",
          "step": "show",
          "visual": {
            "kind": "image",
            "ref": "im05",
            "focus": "Ventilated front seats"
          },
          "fact_ids": [
            "F020"
          ],
          "card": "none",
          "unverified": false,
          "id": "cabin-comfort-D1"
        },
        {
          "text": "Rear passengers benefit from dedicated airflow vents across Pure Plus, Creative, and Fearless variants.",
          "step": "translate",
          "visual": null,
          "fact_ids": [
            "F021"
          ],
          "card": "none",
          "unverified": false,
          "id": "cabin-comfort-D2"
        }
      ],
      "checkin_start": 67.4,
      "checkin_duration": 6.3,
      "start": 52.1,
      "duration": 21.6,
      "spoken": 15.3
