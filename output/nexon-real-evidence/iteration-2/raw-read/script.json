    {
      "id": "boot-practicality",
      "title": "Boot Capacity and Storage Flexibility",
      "role": "proof",
      "topic": "practicality",
      "outcome": "Assessing ISO-measured boot capacity and seating flexibility",
      "usp_ids": [],
      "lines": [
        {
          "text": "Here's the part people ask about for weekend luggage.",
          "step": "frame",
          "visual": {
            "kind": "image",
            "ref": "im06",
            "focus": "Rear luggage boot space"
          },
          "fact_ids": [],
          "card": "none",
          "unverified": false,
          "id": "boot-practicality-L1",
          "start": 73.7,
          "duration": 4.7,
          "exact": false
        },
        {
          "text": "Petrol and diesel trims offer 382 litres of boot space, while the dual-cylinder CNG setup provides 321 litres.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F014",
            "F016"
          ],
          "card": "facts",
          "unverified": false,
          "id": "boot-practicality-L2",
          "start": 78.4,
          "duration": 9.5,
          "exact": false
        }
      ],
      "checkin": "Will that boot capacity accommodate your typical family packing?",
      "deeper": [
        {
          "text": "Boot volume is certified under ISO V215 standards, and the CNG variant uses twin cylinders totalling 60 litres water capacity.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F014",
            "F016"
          ],
          "card": "none",
          "unverified": false,
          "id": "boot-practicality-D1"
        },
        {
          "text": "Starting on Creative Plus PS, you also get sixty-forty flip and fold rear seats to handle longer cargo.",
          "step": "translate",
          "visual": null,
          "fact_ids": [
            "F024"
          ],
          "card": "none",
          "unverified": false,
          "id": "boot-practicality-D2"
        }
      ],
      "checkin_start": 87.9,
      "checkin_duration": 4.7,
      "start": 73.7,
      "duration": 18.9,
      "spoken": 14.2
