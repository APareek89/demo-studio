          "unverified": false,
          "id": "safety-standards-L1",
          "start": 116.8,
          "duration": 4.7,
          "exact": false
        },
        {
          "text": "Every Nexon trim includes six airbags, electronic stability program, and certified five-star crash test safety.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F003",
            "F004",
            "F005",
            "F006"
          ],
          "card": "none",
          "unverified": false,
          "id": "safety-standards-L2",
          "start": 121.5,
          "duration": 7.9,
          "exact": false
        }
      ],
      "checkin": "Is standard safety equipment your top priority when choosing a trim?",
      "deeper": [
        {
