    {
      "id": "powertrain-choices",
      "title": "Engine and Transmission Choices",
      "role": "proof",
      "topic": "performance",
      "outcome": "Selecting between petrol, diesel, and CNG powertrain configurations",
      "usp_ids": [
        "usp-powertrains"
      ],
      "lines": [
        {
          "text": "When it comes to driving, you have three distinct fuel setups.",
          "step": "frame",
          "visual": null,
          "fact_ids": [],
          "card": "none",
          "unverified": false,
          "id": "powertrain-choices-L1",
          "start": 92.6,
          "duration": 5.8,
          "exact": false
        },
        {
          "text": "You can choose a 120 PS turbo petrol, a 115 PS turbo diesel, or a twin-cylinder CNG with manual or automatic gearboxes.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F007",
            "F009",
            "F011",
            "F018"
          ],
          "card": "none",
          "unverified": false,
          "id": "powertrain-choices-L2",
          "start": 98.4,
          "duration": 11.6,
          "exact": false
        }
      ],
      "checkin": "Do you prefer an automatic gearbox or a manual for your daily trips?",
      "deeper": [
        {
          "text": "The 1.2-litre petrol delivers 170 Nm of torque, while the 1.5-litre diesel produces 260 Nm.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F008",
            "F010"
          ],
          "card": "facts",
          "unverified": false,
          "id": "powertrain-choices-D1"
        },
        {
          "text": "If you want the seven-speed dual-clutch automatic, it pairs exclusively with the 1.2-litre petrol engine on Fearless Plus PS.",
          "step": "translate",
          "visual": null,
          "fact_ids": [
            "F018",
            "F019"
          ],
          "card": "none",
          "unverified": false,
          "id": "powertrain-choices-D2"
        }
      ],
      "checkin_start": 110.0,
      "checkin_duration": 6.8,
      "start": 92.6,
      "duration": 24.2,
      "spoken": 17.4
    },
