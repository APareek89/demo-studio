          "visual": null,
          "fact_ids": [
            "F005"
          ],
          "card": "none",
          "unverified": false,
          "id": "overview-intro-L1",
          "start": 0.0,
          "duration": 8.4,
          "exact": false
        },
        {
          "text": "Under four metres long, it combines easy urban parking with certified five-star crash protection.",
          "step": "translate",
          "visual": null,
          "fact_ids": [
            "F003",
            "F005"
          ],
          "card": "none",
          "unverified": false,
          "id": "overview-intro-L2",
          "start": 8.4,
          "duration": 7.4,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "Its compact length fits neatly into tight street parking without sacrificing passenger space.",
          "step": "translate",
          "visual": null,
          "fact_ids": [
            "F005"
          ],
          "card": "none",
          "unverified": false,
          "id": "overview-intro-D1"
        },
        {
          "text": "Both global and Indian crash agencies tested the platform and certified it at five stars.",
          "step": "show",
          "visual": null,
          "fact_ids": [
            "F003",
            "F004"
          ],
          "card": "facts",
          "unverified": false,
