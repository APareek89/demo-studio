          "start": 24.2,
          "duration": 8.4,
          "exact": false
        }
      ],
      "checkin": "",
      "deeper": [
        {
          "text": "Every trim includes six airbags and stability control as standard equipment.",
          "step": "say",
          "visual": null,
          "fact_ids": [
            "F025"
          ],
          "card": "none",
          "unverified": false,
          "id": "three-reminders-D1"
        },
        {
