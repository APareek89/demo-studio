    {
      "id": "overview-intro",
      "title": "Welcome to Tata Nexon",
      "role": "intro",
      "topic": "overview",
      "outcome": "A compact SUV built for family safety and confident commuting",
      "usp_ids": [
        "usp-safety"
      ],
      "lines": [
        {
          "text": "The Tata Nexon is built for everyday city commuting and weekend highway trips with your family.",
