# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RUNWARE_API_KEY=

# Text models: eval is the default; customer opts in to the higher-cost models.
# USD per million input/output tokens (standard, uncached):
# eval: Claude Haiku 4.5 $1/$5; Gemini 3.5 Flash-Lite $0.30/$2.50;
#       Runware DeepSeek V4 Flash $0.076/$0.153.
# customer: Claude Opus 5 $5/$25; Runware GPT-5.5 $5/$30;
#           Gemini 3.8 Flash $0.75/$3.75 through 2026-12-31 UTC,
#           then $1.50/$7.50 from 2027-01-01. Thinking tokens count as output.
# Prices: platform.claude.com/docs/en/about-claude/pricing,
# ai.google.dev/gemini-api/docs/pricing, runware.ai/models (approved 2026-09-18).
MODEL_TIER=eval
RUNTIME_PROVIDERS=gemini,claude,runware
RUNTIME_TIMEOUT=15

# Empty overrides use the chosen tier. Each Claude role uses its tier default;
# Claude runtime inherits CLAUDE_MODEL unless overridden separately.
CLAUDE_MODEL=
CLAUDE_PLAN_MODEL=
CLAUDE_LITE_MODEL=
CLAUDE_RUNTIME_MODEL=
# Text is independent of GEMINI_MODEL (vision). Runtime inherits GEMINI_TEXT_MODEL.
GEMINI_TEXT_MODEL=
GEMINI_RUNTIME_MODEL=
# RUNWARE_TEXT_MODEL overrides eval ONLY. Customer always selects the premium knob.
# /api/health reports the selected effective models; it never probes a provider.
RUNWARE_TEXT_MODEL=deepseek:v4@flash
RUNWARE_TEXT_MODEL_PREMIUM=openai:gpt@5.5

# Optional price assumptions; provider-returned USD always wins for Runware.
# PRICE_CLAUDE_IN=5
# PRICE_CLAUDE_OUT=25
# PRICE_HAIKU_IN=1
# PRICE_HAIKU_OUT=5
# PRICE_GEMINI_TEXT_EVAL_IN=0.30
# PRICE_GEMINI_TEXT_EVAL_OUT=2.50
# PRICE_GEMINI_TEXT_CUSTOMER_IN=0.75
# PRICE_GEMINI_TEXT_CUSTOMER_OUT=3.75
# PRICE_GEMINI_TEXT_CUSTOMER_STANDARD_IN=1.50
# PRICE_GEMINI_TEXT_CUSTOMER_STANDARD_OUT=7.50
# PRICE_RUNWARE_DEEPSEEK_IN=0.076
# PRICE_RUNWARE_DEEPSEEK_OUT=0.153
# PRICE_RUNWARE_GPT55_IN=5
# PRICE_RUNWARE_GPT55_OUT=30

# Optional: Google Cloud Text-to-Speech API key (better Indian-English voices, generous free tier)
GCLOUD_TTS_API_KEY=
# Sarvam AI (Bulbul TTS + Saarika STT) — primary for Indian languages when set; Gemini falls back
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
SARVAM_API_KEY=
# Optional overrides. TTS: sarvam | gemini | gcloud | browser (default: sarvam if its key is set, else gemini)
# STT: sarvam | browser (default: sarvam if its key is set)
TTS_PROVIDER=
STT_PROVIDER=

# Optional absolute path to an installed executable for authoring source rendering.
# Otherwise use installed Mac Chrome, then Playwright's installed Chromium.
# Provision the browser/OS dependencies as the service user; the app never downloads them.
# Chromium sandbox remains enabled. A missing browser disables rendered extraction only.
CRAWL_BROWSER_EXECUTABLE=
